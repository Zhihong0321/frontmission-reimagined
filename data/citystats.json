{
  "_comment": "The catalogue of city stats. Vitals are authored per city in cities.json under 'stats' and carried live in GameState, so events can move them. Supplies are not authored anywhere: each one reads a slice of the city's own market, so it breathes on its own from day one. populationVitalId names the vital that scales industry output.",
  "populationVitalId": "population",
  "vitals": [
    {
      "id": "population",
      "name": "Population",
      "unit": "M",
      "default": 1.0,
      "min": 0.1,
      "max": 2.5,
      "decimals": 1,
      "displayScale": 4.0,
      "blurb": "Souls on the register. Every point of it scales what the city's industries make and eat.",

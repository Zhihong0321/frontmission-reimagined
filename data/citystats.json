          "upTo": 1.2,
          "tone": "ok"
        },
        {
          "id": "metropolis",
          "name": "Metropolis",
          "tone": "good"
        }
      ]
    },
    {
      "id": "peace",
      "name": "Peacefulness",
      "unit": "%",
      "default": 50,
      "min": 0,
      "max": 100,
      "decimals": 0,
